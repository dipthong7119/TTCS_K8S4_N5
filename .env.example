# Database -- doi voi staging/production dung PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://csms:csms@db:5432/csms
DATABASE_URL=sqlite:///./csms.db
CSMS_DB_NAME=csms
CSMS_DB_USER=csms
CSMS_DB_PASSWORD=csms
CSMS_BACKUP_RETENTION_DAYS=14

# T-55: Docker Compose passes these values to the independent OCPP client.
# Count is limited to the 20 SIM- codes already seeded in development.
CSMS_SIMULATOR_COUNT=20
# Opt in to the five extra seeded station devices (25 points at count=20).
CSMS_SIMULATOR_INCLUDE_DEMO_STATIONS=false
CSMS_SIMULATOR_URL=ws://app:8000/ocpp
# Optional version override; main Compose builds csms-simulator:1.0.0 by default.
# CSMS_SIMULATOR_IMAGE=csms-simulator:1.0.0

# Local-only simulator settings (run.ps1 enables and configures these automatically).
CSMS_LOCAL_SIMULATOR_ENABLED=false
CSMS_LOCAL_SIMULATOR_COUNT=20
CSMS_LOCAL_SIMULATOR_INCLUDE_DEMO_STATIONS=true
CSMS_LOCAL_SIMULATOR_URL=ws://127.0.0.1:8000/ocpp

# Security -- THAY GIA TRI NAY TRUOC KHI DEPLOY
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# App
APP_ENV=development
LOG_LEVEL=INFO

# Login protection
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# T-53: chi danh dau phien treo, khong tu dong dong phien hay doan kWh.
SESSION_OFFLINE_GRACE_SECONDS=21600
REMOTE_STOP_REVIEW_SECONDS=120
OCPP_JOB_POLL_SECONDS=60
