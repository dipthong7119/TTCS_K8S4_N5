# Database — PostgreSQL (docker-compose service name: db)
DATABASE_URL=postgresql://csms:csms@db:5432/csms

# Security — đổi SECRET_KEY trong production!
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# App
APP_ENV=development
LOG_LEVEL=INFO

# Login protection (SSD-1)
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
